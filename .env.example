# Copy this file to .env and fill in your actual values
# AziendaOnWeb Client Configuration

# Required credentials
AOW_USERNAME=your_username_here
AOW_PASSWORD=your_password_here

# Optional: AziendaOnWeb base URL
# Default: https://aziendaweb.seac.it
AOW_BASE_URL=https://aziendaweb.seac.it

# Optional: Download directory
# Default: ./invoices/downloaded
AOW_DOWNLOAD_DIR=./invoices/downloaded

# Optional: Remote Download Directory
# Useful for situations where the download directory of the Selenium
# instance differs from the download directory of the AOW Client,
# like when using Selenium remotely with docker mappings.
# Ignored if AOW_REMOTE_ENABLED=false
# Default: /home/seluser/downloads
AOW_REMOTE_DOWNLOAD_DIR=/home/seluser/downloads


# Optional: Path to .env file (if not in current directory)
# Default: ./.env
AOW_ENV_PATH=./.env

# Optional: Session timeout in seconds
# Default: 180 (3 minutes)
AOW_SESSION_TIMEOUT=180

# Optional: Element wait timeout in seconds
# Default: 10
AOW_ELEMENT_TIMEOUT=10

# Optional: Download timeout in seconds
# Default: 30
AOW_DOWNLOAD_TIMEOUT=30

# Optional: Page load wait in seconds
# Default: 1.0
AOW_PAGE_LOAD_WAIT=1.0

# Optional: Download wait in seconds
# Default: 3.0
AOW_DOWNLOAD_WAIT=3.0

# Optional: Use remote Selenium Grid driver instead of local Chrome
# Default: false
AOW_REMOTE_ENABLED=false

# Optional: Remote Selenium Grid host URL (required if AOW_REMOTE_ENABLED=true)
# Example: http://localhost:4444
AOW_REMOTE_HOST=http://selenium:4444

# Optional: Path to Chrome binary
# Leave empty to use the system Chrome installation
# Example: /usr/bin/chromium-browser
AOW_CHROME_BINARY_PATH=

# Invoice Manager Configuration

# Required to connect to a database
# Used to get a database engine using SQLAlchemy.
# Example: sqlite:///im.sqlite
INVOICEMANAGER_DATABASE_STRING=sqlite:///im.sqlite

# Optional: Directory where the Invoice Manager will find the
# downloaded invoices
# Default: ./invoices/downloaded
INVOICEMANAGER_DOWNLOADED_DIR=./invoices/downloaded

# Optional: Directory where the Invoice Manager will store
# (archive) the confirmed invoices.
# Default: ./invoices/confirmed
INVOICEMANAGER_CONFIRMED_DIR=./invoices/confirmed

# Optional: Path to .env file (if not in current directory)
# Default: ./.env
INVOICE_MANAGER_ENV_PATH=./env

# Optional: amount of minutes after which a printing job will be considered failed, even though
# the printing backend still reports "PENDING".
# Default: 30
INVOICEMANAGER_PRINTING_TIMEOUT_MINUTES=30

# Optional: number of failed print tries after which redownload will be attempted with the hope of fixing a corrupted file. 0 or not set to disable.
# Default: 0
INVOICEMANAGER_PRINTING_TRIES_LIMIT=0

# Currently, only CUPS is supported. If not set, or a non valid backend is specified, a fallback backend will be used, which will allow Invoice Manager to work just as a storage solution.
INVOICEMANAGER_PRINTING_BACKEND=CUPS

# Ignored if INVOICEMANAGER_PRINTING_BACKEND is not CUPS
# The host of a CUPS instance
INVOICEMANAGER_CUPS_HOST=127.0.0.1

# Ignored if INVOICEMANAGER_PRINTING_BACKEND is not CUPS
# The port at which the CUPS instance
# is running at INVOICEMANAGER_CUPS_HOST
INVOICEMANAGER_CUPS_PORT=631

# Discord Bot Configuration
# The authentication token for the Discord bot
DISCORD_BOT_TOKEN=xxxxx

# The ID of the Discord server (guild) where the bot will operate
DISCORD_BOT_GUILD_ID=xxxxx

# The primary channel ID for bot notifications and interactions
DISCORD_BOT_MAIN_CHANNEL_ID=xxxxxx

# The channel ID where the bot will send logs and error messages
DISCORD_BOT_LOG_CHANNEL_ID=xxxxx

# Optional: The language/locale for the bot's interface
# Default: en-US
DISCORD_BOT_LANGUAGE=en-US